# Puerto en el que se ejecuta el servidor Express
PORT=3000

# URL de conexión a la base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# Clave secreta para la firma de tokens JWT
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="tu_clave_secreta_jwt_super_segura_aqui"

# Tiempo de validez del token JWT (ej: 24h, 7d, 1h)
JWT_EXPIRATION="24h"

# Origen permitido para solicitudes CORS (URL de tu frontend)
CORS_ORIGIN="http://localhost:5173"

# =============================================================================
# Variables del Super Administrador — Solo para el script: npm run seed
# =============================================================================
# NUNCA subas estos valores al repositorio. Mantenlos únicamente en tu .env local
# o en las variables de entorno seguras de tu servidor (Render, Railway, etc.)
SUPER_ADMIN_EMAIL="admin@tudominio.com"
SUPER_ADMIN_NAME="Tu Nombre"
SUPER_ADMIN_LASTNAME="Tu Apellido"
SUPER_ADMIN_PHONE="+57XXXXXXXXXX"
SUPER_ADMIN_PASSWORD="TuContraseñaSegura123."
