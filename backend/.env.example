# Puerto en el que se ejecuta el servidor Express
PORT=3000

# URL de conexión a la base de datos PostgreSQL (Neon u otro proveedor)
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_db?schema=public"

# Clave secreta para la firma de tokens JWT (Usar una cadena de caracteres aleatoria y segura en producción)
JWT_SECRET="tu_clave_secreta_jwt_super_segura"

# Tiempo de validez del token JWT (ej: 24h, 7d, 1h)
JWT_EXPIRATION="24h"

# Origen permitido para solicitudes cross-origin (URL de tu frontend en desarrollo o producción)
CORS_ORIGIN="http://localhost:5173"
